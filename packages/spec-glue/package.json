{
  "name": "@computerwwwizards/spec-glue",
  "version": "0.1.0",
  "description": "Binds implementation handlers to Markdown-declared spec steps (Scenario/Step pattern matching and execution).",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "computerwwwizards",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/computerwwwizards/spec-driven-development.git",
    "directory": "packages/spec-glue"
  },
  "keywords": [
    "spec",
    "bdd",
    "markdown",
    "test-automation",
    "scenario"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "rslib build",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@rslib/core": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
